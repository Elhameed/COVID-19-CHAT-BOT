# Optional configuration for the API service (src/api.py).
# All of these have sensible defaults; copy to .env only to override one.

# Explicit CORS origins. Never "*" together with credentials.
# Comma-separated JSON list, e.g. '["https://covicare.example.com"]'
# COVICARE_CORS_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080"]
# COVICARE_CORS_ALLOW_CREDENTIALS=false

# Per-client rate limit on POST /predict. GET /health is never limited.
# COVICARE_RATE_LIMIT=30/minute

# Log the raw question text at DEBUG. Off by default: these are health
# questions, and the INFO log already records a salted hash plus the length,
# which is enough to correlate a bug report without storing what was asked.
# COVICARE_LOG_QUERIES=false
# COVICARE_LOG_SALT=change-me-in-deployment

# How many candidates to retrieve before applying the abstention threshold.
# COVICARE_TOP_K=5
