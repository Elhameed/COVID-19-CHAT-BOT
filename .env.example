# Environment for the Jupyter MCP server (see docs/jupyter-mcp.md).
#
# .mcp.json is COMMITTED and holds no secrets -- it references these by
# ${VAR} expansion. Set the real values in one of:
#
#   1. .claude/settings.local.json  ->  {"env": {"JUPYTER_TOKEN": "..."}}
#      (preferred; gitignored, picked up automatically by Claude Code)
#   2. your shell, before launching Claude Code:
#      export JUPYTER_TOKEN=...          # bash
#      $env:JUPYTER_TOKEN = "..."        # PowerShell
#
# Generate a token with:
#   python -c "import secrets; print(secrets.token_hex(32))"

# Auth token shared by the Jupyter server and the MCP server. No default --
# the MCP server cannot connect without it.
JUPYTER_TOKEN=

# Where JupyterLab is listening. Defaults to http://localhost:8888.
JUPYTER_URL=http://localhost:8888

# Notebook the MCP server attaches to by default. Omit to choose interactively.
DOCUMENT_ID=notebooks/development.ipynb

# ---------------------------------------------------------------------------
# API service (src/api.py). All optional — the defaults suit local development.
# ---------------------------------------------------------------------------

# Explicit CORS origins. Never "*" with credentials (PRD §10.3).
# Comma-separated JSON list, e.g. '["https://covicare.example.com"]'
# COVICARE_CORS_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080"]
# COVICARE_CORS_ALLOW_CREDENTIALS=false

# Per-client rate limit on POST /predict. /health is never limited.
# COVICARE_RATE_LIMIT=30/minute

# Log the raw question text at DEBUG. Off by default: these are health
# questions, and the INFO log already records a salted hash plus the length,
# which is enough to correlate a report without storing what was asked.
# COVICARE_LOG_QUERIES=false
# COVICARE_LOG_SALT=change-me-in-deployment

# How many candidates to retrieve before thresholding.
# COVICARE_TOP_K=5
