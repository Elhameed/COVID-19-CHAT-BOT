# --- Python ---
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- Jupyter ---
# Checkpoints and local server runtime state, not deliverables.
.ipynb_checkpoints/
.jupyter/
.jupyter_token
.jupyter_ystore.db
.jupyter_ystore.db-*
*.ystore.db

# --- Secrets / local config ---
.env
.env.*
!.env.example
*.key

# --- Local developer tooling ---
# Machine-local notes, editor and assistant config. Nothing in src/, tests/,
# app/ or the notebook depends on any of it.
PRD.md
CLAUDE.md
AGENTS.md
.claude/
.mcp.json
.continue/
.cursorrules
.windsurfrules
.aider*
.github/copilot-instructions.md
scripts/

# --- Raw datasets ---
# COUGH is CC BY-NC-SA 4.0 and is fetched by `python -m src.download`, never
# committed. Only derived, documented artifacts belong in git; everything here
# is regenerated by `python -m src.prep`.
data/raw/
data/*.csv
data/*.parquet
data/*.jsonl
!data/splits/*.json

# --- Embedding caches (regenerated by `python -m src.index`) ---
data/embeddings/
*.npy
*.npz
*.faiss

# --- Model weights ---
*.safetensors
*.bin
*.pt
*.pth
*.h5
*.ckpt

# No model weights are committed. The encoder is a stock Hugging Face model
# fetched on first use, and the KB embeddings above are derived data.

# --- Hugging Face cache ---
.cache/
hf_cache/

# --- Training / experiment output ---
outputs/
runs/
wandb/
events.out.tfevents.*

# --- OS ---
.DS_Store
Thumbs.db
