# --- Python ---
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- Jupyter ---
.ipynb_checkpoints/

# Real-time-collaboration runtime state, created by jupyter-collaboration when
# the server runs. The YDoc CRDT store is a live scratch database, not a
# deliverable -- committing it would leak notebook edit history and conflict on
# every machine.
.jupyter/
.jupyter_ystore.db
.jupyter_ystore.db-*
*.ystore.db

# --- Secrets / local config ---
.env
.env.*
!.env.example
*.key

# --- Private: development tooling and internal planning ---
# These stay on the developer's machine. They are not part of the deliverable,
# and nothing in src/, tests/, app/ or the notebook depends on them.
#
# Already-tracked files needed `git rm --cached` as well as these rules; a
# .gitignore entry alone does not stop tracking something git already knows.
PRD.md
CLAUDE.md
.claude/
.mcp.json
.jupyter_token
.jupyter/
.jupyter_ystore.db
.jupyter_ystore.db-*
*.ystore.db
scripts/start_jupyter.py
AGENTS.md
.cursorrules
.aider*
.continue/
.windsurfrules
.github/copilot-instructions.md

# --- Raw datasets ---
# COUGH is CC BY-NC-SA 4.0 and is fetched by `python -m src.download`, never
# committed. Only derived, documented artifacts belong in git; everything here
# is regenerated by `python -m src.prep`.
data/raw/
data/*.csv
data/*.parquet
data/*.jsonl
!data/splits/*.json

# --- Embedding caches (regenerated by `python -m src.index`) ---
data/embeddings/
*.npy
*.npz
*.faiss

# --- Model weights ---
*.safetensors
*.bin
*.pt
*.pth
*.h5
*.ckpt

# No model weights are committed. The encoder is a stock Hugging Face model
# fetched on first use, and the KB embeddings above are derived data.
#
# Kept as a deliberate reminder: the previous implementation's entire .gitignore
# was the single line `*.safetensors`, its weights never reached the repo, and
# `from_pretrained("./model")` raised OSError on every fresh clone.

# --- Hugging Face cache ---
.cache/
hf_cache/

# --- Training / experiment output ---
outputs/
runs/
wandb/
events.out.tfevents.*

# --- OS ---
.DS_Store
Thumbs.db
