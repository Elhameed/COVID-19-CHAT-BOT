# --- Python ---
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- Jupyter ---
.ipynb_checkpoints/

# --- Secrets / local config ---
.env
.env.*
!.env.example
*.key

# --- Raw datasets ---
# COUGH is CC BY-NC-SA 4.0 and is fetched by `python -m src.download`, never
# committed. Only derived, documented artifacts belong in git; everything here
# is regenerated by `python -m src.prep`.
data/raw/
data/*.csv
data/*.parquet
data/*.jsonl
!data/splits/*.json

# --- Embedding caches (regenerated by `python -m src.index`) ---
data/embeddings/
*.npy
*.npz
*.faiss

# --- Model weights ---
*.safetensors
*.bin
*.pt
*.pth
*.h5
*.ckpt

# --- EXCEPTION: the trained-model artifact (PRD §7.4, §22 #5) ------------------
# artifacts/encoder/ is the exported fine-tuned bi-encoder that src/api.py loads.
# It is a deliverable, not a cache, and the rules above would otherwise swallow
# its model.safetensors.
#
# This is not a hypothetical. The previous implementation's .gitignore was the
# single line `*.safetensors`; the weights never reached the repo, and
# `from_pretrained("./model")` raised OSError on every fresh clone. The backend
# could not start. Do not remove these negations without re-reading PRD §22 #5.
#
# MiniLM exports at ~90 MB, which is fine to vendor. If we switch to bge-base
# (~440 MB), revisit: fetch it as a release asset or via Git LFS instead.
!artifacts/
!artifacts/**/
!artifacts/**/*.safetensors
!artifacts/**/*.bin
!artifacts/**/*.pt

# Training scratch under artifacts/ stays out (checkpoints, optimizer state).
artifacts/**/checkpoint-*/
artifacts/**/optimizer.pt
artifacts/**/scheduler.pt
artifacts/**/rng_state.pth
# ------------------------------------------------------------------------------

# --- Hugging Face cache ---
.cache/
hf_cache/

# --- Training / experiment output ---
outputs/
runs/
wandb/
events.out.tfevents.*

# --- OS ---
.DS_Store
Thumbs.db
